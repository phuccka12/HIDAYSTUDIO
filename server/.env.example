# Example env for the Express + MongoDB server
# Copy to server/.env and set the real MongoDB URI
# You can use either MONGO_URL or MONGODB_URI (both supported)

MONGO_URL=mongodb://localhost:27017/ielts-dev
# MONGODB_URI=mongodb://user:pass@host:port/ielts-prod

# Server port
PORT=4000

# Gemini AI Configuration for Writing Grader
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_MAX_TOKENS=8192
